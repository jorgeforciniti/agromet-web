# Sólo los endpoints se pueden pedir desde afuera; los archivos de apoyo no.
<FilesMatch "^(config|comun|conecta_admin|conecta_colmenar)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.log$">
  Require all denied
</FilesMatch>

# Apache con PHP-FPM/CGI no siempre pasa el header Authorization a PHP
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

Options -Indexes
